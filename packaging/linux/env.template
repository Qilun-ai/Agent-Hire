# Agent-Hire settings for this install. Read by ./agent-hire on every start; restart after editing
# (./agent-hire restart). Keep this file private: it can hold API keys (the installer sets it to 600).

# The address you open in the browser, and the API port behind it.
APP_PORT=__APP_PORT__
API_INTERNAL_PORT=__API_PORT__

# ---- AI provider -----------------------------------------------------------------------------
# Keys already exported in your shell (~/.bashrc, ~/.profile) are used automatically, so most
# people leave this section alone. Recognised names, for each provider:
#   OPENAI_API_KEY, OPENAI_API, OPENAI_KEY, OPENAI_API_KEY_1, OPENAI_API_1
# Providers: ANTHROPIC, GEMINI (also GOOGLE_API_KEY), OPENAI, OPENCODE, OPENROUTER, DEEPSEEK, GROQ,
# NVIDIA, MISTRAL, XAI, MOONSHOT, TOGETHER, FIREWORKS, CEREBRAS, PERPLEXITY, COHERE, SAMBANOVA,
# DASHSCOPE, HF_TOKEN (Hugging Face). A key typed into the app's Settings always wins.
# On first start, if you have not chosen a provider in the app, the first provider with a key
# is selected for you. To set a key only for Agent-Hire, uncomment one line:
#OPENAI_API_KEY=
#GEMINI_API_KEY=
#OPENCODE_API_KEY=
# OpenCode keys go to the OpenCode Go endpoint by default; for OpenCode Zen set:
#OPENCODE_BASE_URL=https://opencode.ai/zen/v1

# ---- Decision model (optional) ---------------------------------------------------------------
# A System One compatible endpoint that judges which jobs fit you. Set it here or in the app
# (Settings → Job agent); the app's value wins when both are set.
#AGENT_HIRE_DECISION_API_URL=
#AGENT_HIRE_DECISION_API_KEY=
#AGENT_HIRE_DECISION_API_MODEL=

# ---- Sandbox ---------------------------------------------------------------------------------
# auto: use bubblewrap when available (only this folder is writable or visible in your home);
# required: refuse to start without it; off: no sandbox (paths still stay inside this folder).
#AGENT_HIRE_SANDBOX=auto
# Set to 0 to stop reading provider keys from your login shell.
#AGENT_HIRE_IMPORT_SHELL_KEYS=1

# Companies scraped in parallel during a job scrape.
#AGENT_HIRE_SCRAPE_CONCURRENCY=4
