    "GET https://jobs.twilio.com/api/pcsx/search?domain=twilio.com&query=&location=&start=0&filter_custom_department=engineering -> count=17, appliedFilters={\"customDepartment\":[\"engineering\"]}"
  ],
  "verified": true
